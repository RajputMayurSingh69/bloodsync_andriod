# ==============================================================================
# BloodSync Backend - Environment Configuration
# ==============================================================================
# WARNING: Never commit actual secret keys or .env files to source control.
# Copy this file to .env and configure real credentials securely.

# Server Configuration
NODE_ENV=development
PORT=5000
SERVER_BASE_URL=http://localhost:5000

# Gmail SMTP Configuration
# NOTE: Do NOT use your personal Gmail login password.
# You must enable 2-Step Verification and generate a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-bloodsync-alerts@gmail.com
SMTP_PASSWORD=your_16_char_app_password_here
EMAIL_FROM_NAME="BloodSync Security Team"
EMAIL_FROM_ADDRESS=your-bloodsync-alerts@gmail.com

# Firebase Admin SDK Configuration
# Option 1: Path to Firebase Service Account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# Option 2: Individual variables (for Cloud / Container deployment)
FIREBASE_PROJECT_ID=bloodsync-3b5cf
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@bloodsync-3b5cf.iam.gserviceaccount.com
# Use actual private key with escaped newlines: "-----BEGIN PRIVATE KEY-----\nMIIEvg...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""

# Security & OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_SALT_SECRET=replace_with_a_secure_random_64_character_hex_salt_string
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRATION="24h"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=3
RATE_LIMIT_COOLDOWN_SECONDS=60

# Real-Time Monitoring & Debugger Alerts
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
ALERT_NOTIFICATION_EMAIL=admin-alerts@bloodsync.org
ENABLE_REALTIME_ALERTS=true
